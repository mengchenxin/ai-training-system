# 本地私有配置 —— 请复制此文件为 application-local.yml 并填入真实值
# application-local.yml 已被 .gitignore 排除，不会提交到仓库
#
# 两种方式任选其一：
#   1. 复制本文件为 application-local.yml，填下面的 password
#   2. 不建文件，改为设置环境变量 DB_PASSWORD

spring:
  datasource:
    username: root
    password: your_mysql_password

# 如需启用大模型，取消注释并填入 key（也可用环境变量 DEEPSEEK_API_KEY）
# ai:
#   llm:
#     api-key: sk-your-deepseek-api-key
