# ===== 本地私有配置（含数据库密码，禁止入库）=====
application-local.yml
application-local.yaml

# ===== 个人本地脚本（内含个人仓库地址，不入库）=====
push.bat

# ===== 备份目录 =====
.backup-*/
*.bak

# ===== IDE =====
.idea/
*.iml
.vscode/
*.ipr
*.iws

# ===== 安装包（体积过大，不入库）=====
installers/

# ===== 第三方参考模板（非本项目代码）=====
work/work/

# ===== 诊断输出 =====
_diagnostics/

# ===== 日志 =====
*.log
logs/
_run.log

